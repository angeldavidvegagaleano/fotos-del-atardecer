<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#17101d">
  <title>Fotos del atardecer</title>
  <style>
    * { box-sizing: border-box; }
    :root { color-scheme: dark; }
    html, body { min-height: 100%; margin: 0; }
    body {
      min-height: 100vh;
      padding: 22px 18px 36px;
      font-family: Arial, sans-serif;
      text-align: center;
      background-image:
        linear-gradient(rgba(13, 9, 20, .22), rgba(8, 8, 17, .42)),
        url("data:image/jpeg;base64,");
      background-size: cover;
      background-position: center center;
      background-attachment: fixed;
      background-repeat: no-repeat;
      background-color: #17101d;
    }
    h1 {
      margin: 8px auto 22px;
      color: #0000ff;
      font-family: Castellar, "Copperplate", fantasy;
      font-size: clamp(27px, 4vw, 42px);
      font-weight: 700;
      line-height: 1.18;
      text-shadow: 0 1px 5px rgba(255,255,255,.72);
    }
    main { width: min(100%, 980px); margin: 0 auto; }
    .camara-panel {
      width: min(100%, 430px);
      margin: 0 auto;
      padding: 12px;
      border: 1px solid rgba(255,255,255,.38);
      border-radius: 15px;
      background: rgba(12, 12, 20, .58);
      box-shadow: 0 8px 28px rgba(0,0,0,.32);
      backdrop-filter: blur(5px);
    }
    video {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 9px;
      background: rgba(0,0,0,.6);
    }
    .controles {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 9px;
      margin-top: 11px;
    }
    button {
      min-height: 43px;
      padding: 10px 16px;
      border: 1px solid rgba(255,255,255,.45);
      border-radius: 8px;
      background: rgba(20, 25, 65, .92);
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(0,0,0,.2);
    }
    button.primary { background: #2229a8; }
    button:hover { filter: brightness(1.15); }
    button:disabled { opacity: .58; cursor: wait; }
    .galeria {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
      gap: 12px;
      margin: 22px auto 0;
      align-items: start;
    }
    .foto {
      margin: 0;
      padding: 7px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.58);
      border-radius: 8px;
      background: rgba(13, 13, 23, .76);
      box-shadow: 0 5px 18px rgba(0,0,0,.34);
      transform: rotate(var(--tilt, 0deg));
      backdrop-filter: blur(3px);
    }
    .foto img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 4px;
    }
    .foto time {
      display: block;
      padding: 6px 2px 1px;
      color: white;
      font-size: 11px;
      text-shadow: 0 1px 3px #000;
    }
    .aviso {
      display: none;
      margin: 12px auto 0;
      max-width: 430px;
      color: white;
      font-size: 13px;
      text-shadow: 0 1px 4px #000;
    }
    @media (max-width: 520px) {
      body { padding: 15px 10px 26px; background-attachment: scroll; }
      .galeria { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
      .foto { padding: 5px; }
      button { flex: 1 1 145px; }
    }
  </style>
</head>
<body>
  <main>
    <h1>Fotos del atardecer</h1>

    <section class="camara-panel" aria-label="Cámara para fotografiar el atardecer">
      <video id="camara" autoplay playsinline muted></video>
      <div class="controles">
        <button id="activar" type="button">Abrir cámara</button>
        <button id="cambiar" type="button" disabled>Cambiar cámara</button>
        <button id="capturar" class="primary" type="button" disabled>📸 Tomar foto</button>
      </div>
    </section>

    <p id="aviso" class="aviso" role="status" aria-live="polite"></p>
    <canvas id="canvas" hidden></canvas>
    <section id="galeria" class="galeria" aria-label="Galería de fotos"></section>
  </main>

  <script>
    const SHEETY_API_URL = "https://api.sheety.co/c955600c4af5ce785187025219471a5c/webcamBase64/hoja1";

    const video = document.getElementById("camara");
    const activarBtn = document.getElementById("activar");
    const cambiarBtn = document.getElementById("cambiar");
    const capturarBtn = document.getElementById("capturar");
    const canvas = document.getElementById("canvas");
    const galeria = document.getElementById("galeria");
    const aviso = document.getElementById("aviso");

    let streamActual = null;
    let camaraActual = "environment";

    function informar(mensaje) {
      aviso.textContent = mensaje;
      aviso.style.display = mensaje ? "block" : "none";
    }

    async function iniciarCamara(modo = camaraActual) {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        informar("Este navegador no permite acceder a la cámara. Abre la página mediante HTTPS.");
        return;
      }

      activarBtn.disabled = true;
      informar("Solicitando acceso a la cámara…");

      try {
        if (streamActual) {
          streamActual.getTracks().forEach(track => track.stop());
          streamActual = null;
        }

        const nuevoStream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: {
            facingMode: { ideal: modo },
            width: { ideal: 1280 },
            height: { ideal: 960 }
          }
        });

        streamActual = nuevoStream;
        video.srcObject = nuevoStream;
        camaraActual = modo;
        await video.play();

        cambiarBtn.disabled = false;
        capturarBtn.disabled = false;
        activarBtn.textContent = "Reabrir cámara";
        informar("");
      } catch (error) {
        console.error("No se pudo iniciar la cámara:", error);
        const detalle = error.name === "NotAllowedError"
          ? "Permite el acceso a la cámara en el navegador para tomar fotos."
          : "No se pudo abrir esa cámara. Comprueba los permisos o prueba la otra cámara.";
        informar(detalle);
      } finally {
        activarBtn.disabled = false;
      }
    }

    activarBtn.addEventListener("click", () => iniciarCamara(camaraActual));

    cambiarBtn.addEventListener("click", async () => {
      const siguiente = camaraActual === "user" ? "environment" : "user";
      await iniciarCamara(siguiente);
    });

    function agregarFoto(base64, fecha) {
      const tarjeta = document.createElement("figure");
      tarjeta.className = "foto";
      tarjeta.style.setProperty("--tilt", `${(Math.random() * 2.4 - 1.2).toFixed(2)}deg`);

      const imagen = document.createElement("img");
      imagen.src = base64;
      imagen.alt = "Fotografía del atardecer";
      imagen.loading = "lazy";

      const pie = document.createElement("time");
      pie.textContent = fecha || "Foto del atardecer";

      tarjeta.append(imagen, pie);
      galeria.prepend(tarjeta);
    }

    async function cargarFotos() {
      try {
        const respuesta = await fetch(SHEETY_API_URL);
        if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);

        const datos = await respuesta.json();
        const clave = Object.keys(datos)[0];
        const filas = Array.isArray(datos[clave]) ? datos[clave] : [];

        galeria.replaceChildren();
        filas.forEach((fila) => {
          const base64 = fila.imagenbase64 ||
            Object.values(fila).find(valor =>
              typeof valor === "string" && valor.startsWith("data:image/")
            );
          if (base64) agregarFoto(base64, fila.fecha);
        });
      } catch (error) {
        console.error("No se pudieron cargar las fotos de Sheety:", error);
        informar("No se pudieron cargar las fotos guardadas. Puedes volver a intentarlo más tarde.");
      }
    }

    async function guardarFoto(base64) {
      const payload = {
        hoja1: {
          fecha: new Date().toLocaleString(),
          imagenbase64: base64
        }
      };

      const respuesta = await fetch(SHEETY_API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (!respuesta.ok) {
        const detalle = await respuesta.text();
        throw new Error(`Sheety respondió ${respuesta.status}: ${detalle}`);
      }
    }

    capturarBtn.addEventListener("click", async () => {
      if (!streamActual || !video.videoWidth) {
        informar("Primero abre la cámara.");
        return;
      }

      capturarBtn.disabled = true;
      capturarBtn.textContent = "Guardando…";

      try {
        let escala = Math.min(
         1,
          800 / Math.max(video.videoWidth, video.videoHeight)
        );

        let calidad = 0.50;
        let fotoBase64 = "";

        
        agregarFoto(fotoBase64, new Date().toLocaleString());
        informar("Foto guardada en la galería.");
      } catch (error) {
        console.error("Error al guardar la foto:", error);
        informar("No se pudo guardar la foto en Sheety. Comprueba la conexión e inténtalo de nuevo.");
      } finally {
        capturarBtn.disabled = !streamActual;
        capturarBtn.textContent = "📸 Tomar foto";
      }
    });

    window.addEventListener("pagehide", () => {
      if (streamActual) streamActual.getTracks().forEach(track => track.stop());
    });

    cargarFotos();
  </script>
</body>
</html>
